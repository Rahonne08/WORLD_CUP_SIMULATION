rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserProfileCreate(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidUserProfileUpdate(data) {
      return data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfileCreate(incoming());
                       
      allow update: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfileUpdate(incoming()) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
                       ) &&
                       incoming().createdAt == existing().createdAt;
                       
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    function isValidSimulationCreate(data) {
      return data.keys().hasAll(['userId', 'state', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.state is string && data.state.size() <= 1048576 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidSimulationUpdate(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.state is string && data.state.size() <= 1048576 &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    match /simulations/{simulationId} {
      allow get: if isSignedIn() && isValidId(simulationId) && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(simulationId) &&
                       isValidSimulationCreate(incoming()) &&
                       exists(/databases/$(database)/documents/users/$(incoming().userId));
      
      allow update: if isSignedIn() && isValidId(simulationId) &&
                       existing().userId == request.auth.uid &&
                       isValidSimulationUpdate(incoming()) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['state', 'updatedAt'])
                       ) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId;
                       
      allow delete: if isSignedIn() && isValidId(simulationId) && existing().userId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

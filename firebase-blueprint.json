{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the user",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "Simulation": {
      "title": "Simulation",
      "description": "A saved World Cup simulation state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "state": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "state", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "simulations/{simulationId}": {
      "schema": "Simulation",
      "description": "User saved simulations"
    }
  }
}
